!/tools/*.ps1
!/tools/*.py
!/tools/*.cs
!/tools/package-templates/
!/tools/font-subset/
/tools/font-subset/*
!/tools/font-subset/build_subset.py
!/tools/font-subset/requirements.txt
!/tools/font-subset/README.txt

# Built players and Unity-generated machine state.
/builds/
